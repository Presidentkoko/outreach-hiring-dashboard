# Google Sheet that feeds the dashboard (optional, defaults to the demo sheet in src/config/settings.ts)
SHEET_ID=

# Production: base64 of the service-account JSON. Share the sheet with the service account's client_email.
# Leave empty to fall back to the public CSV export (sheet must be shared "anyone with the link").
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=

# Data source. Only "sheets" exists in version 1; "ghl" is where the GoHighLevel source plugs in.
DATA_SOURCE=sheets
